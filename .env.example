# Server-side SmartBilling API origin, used by Next.js route handlers and server components.
BILLING_API_URL=http://localhost:3001
# Optional; only needed if browser code calls the Billing API directly (requires CORS).
NEXT_PUBLIC_BILLING_API_URL=http://localhost:3001
# Copy the generated Portal session secret from SmartBilling's admin settings.
PORTAL_SESSION_SECRET=
